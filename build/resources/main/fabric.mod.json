{
  "schemaVersion": 1,
  "id": "keypadlock",
  "version": "1.0.0",
  "name": "Keypad Lock",
  "description": "Sistema de candados/teclado numerico para cofres y puertas de hierro. Todo server-authoritative: passwords, ownership y refuerzo/desrefuerzo de bloques se validan en el servidor.",
  "authors": ["nahv"],
  "entrypoints": {
    "main": [
      { "adapter": "kotlin", "value": "com.keypadlock.KeypadLockMod" }
    ],
    "client": [
      { "adapter": "kotlin", "value": "com.keypadlock.client.KeypadLockModClient" }
    ]
  },
  "mixins": [
    { "config": "keypadlock.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.12",
    "minecraft": "26.2"
  }
}
